# ---- Supabase (required) — Project Settings > API ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never expose to the browser

# ---- Sign-up controls ----
# Anyone with this code can create a new organization (school group) at /signup.
OWNER_SIGNUP_CODE=pick-a-secret-code

# ---- Demo mode (for trying the app before entering real data) ----
# When true, the login page shows one-click demo logins created by `npm run seed:demo`.
NEXT_PUBLIC_DEMO_MODE=true
DEMO_PASSWORD=demo-password-change-me

# ---- AI assistant (optional) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ---- Cron (recurring invoices) ----
CRON_SECRET=generate-a-long-random-string
