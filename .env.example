# ---- Supabase (required) — Project Settings > API ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never expose to the browser

# ---- Sign-up controls ----
# Anyone with this code can create a new organization (school group) at /signup.
OWNER_SIGNUP_CODE=pick-a-long-secret-code

# ---- Security ----
# Owners and directors must use two-step verification (authenticator app). Set to false only for testing.
REQUIRE_ADMIN_MFA=true

# ---- Demo mode (for trying the app before entering real data) ----
# When true, the login page shows one-click demo logins (create them at /demo/setup).
# Demo accounts are exempt from two-step verification and hold only fictional data.
NEXT_PUBLIC_DEMO_MODE=true
DEMO_PASSWORD=demo-password-change-me

# ---- Live video (optional) ----
# For cameras added as "mux:PLAYBACK_ID": families get playback links that expire within 10 minutes.
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=   # base64 private key from Mux > Settings > Signing keys

# ---- AI assistant (optional) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ---- Cron (recurring invoices) ----
CRON_SECRET=generate-a-long-random-string
