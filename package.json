{
  "name": "kidhub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "All-in-one childcare center platform: attendance, care logs, daily reports, billing, messaging, live video permissions and AI alerts.",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:db": "node --experimental-strip-types --test tests/db/*.test.ts",
    "seed:demo": "node --experimental-strip-types --env-file=.env.local scripts/seed-demo.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "hls.js": "^1.7.3",
    "next": "^15.5.28",
    "react": "^19.2.9",
    "react-dom": "^19.2.9",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  }
}
